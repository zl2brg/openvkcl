<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app is signed with the hardened runtime, which gives an app without
       this entitlement silence from the microphone. The voice keyer records
       its messages from it. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
