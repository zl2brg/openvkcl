{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVKCL",
  "version": "0.5.1",
  "identifier": "nz.zl.openvkcl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenVKCL",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright © 2026 Simon, ZL2BRG",
    "homepage": "https://github.com/zl2brg/openvkcl",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "recommends": ["libhamlib-utils", "extra-xdg-menus"],
        "desktopTemplate": "linux/openvkcl.desktop"
      },
      "rpm": {
        "recommends": ["hamlib"],
        "desktopTemplate": "linux/openvkcl.desktop"
      }
    }
  }
}
